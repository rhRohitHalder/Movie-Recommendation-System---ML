# =============================================================
# Movie Recommendation System - Environment Configuration
# =============================================================

# 1. The Movie Database (TMDB) API Key (v3 auth)
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# 2. FastAPI Backend URL (used by the Streamlit frontend)
# Local development default: http://127.0.0.1:8000
# Production deployment: https://<your-backend-service>.onrender.com
API_BASE=http://127.0.0.1:8000

# 3. Server Port (used by uvicorn or cloud hosting like Render/Heroku)
PORT=8000

